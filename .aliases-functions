function kall --description 'kubectl get -A; "sm" expands to servicemonitor'
    set -l args $argv
    test "$args[1]" = sm; and set args[1] servicemonitor
    kubectl get -A $args
end

function ke --description 'kubectl edit; "sm" expands to servicemonitor'
    set -l args $argv
    test "$args[1]" = sm; and set args[1] servicemonitor
    kubectl edit $args
end
