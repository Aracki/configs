function gpl --wraps='git pull' --description 'git pull: fast-forward only, fall back to no-ff merge if diverged'
    git pull --ff-only $argv
    or git pull --no-ff $argv
end

function gm --description 'Checkout default branch (master, else main), hard reset to origin, and pull'
    set -l branch master
    if not git show-ref --verify --quiet refs/heads/master; and not git show-ref --verify --quiet refs/remotes/origin/master
        set branch main
    end
    git checkout $branch
    and git reset --hard origin/$branch
    and git pull origin $branch
end

function gc --wraps='git checkout' --description 'git checkout: create the branch with -b if it does not exist, plain checkout if it does'
    set -l branch $argv[1]
    if test -z "$branch"; or git show-ref --verify --quiet refs/heads/$branch; or git show-ref --verify --quiet refs/remotes/origin/$branch
        git checkout $argv
    else
        git checkout -b $argv
    end
end

function kdbg
    kubectl debug -it $argv[1] --image nicolaka/netshoot -- /bin/bash
end

function ktpn --argument node_name
    printf "%-60s %-30s %-30s\n" "Node" "CPU" "Memory"
    for line in (kgp -A --field-selector=metadata.namespace!=kube-system,metadata.namespace!=gmp-system,metadata.namespace!=monitoring,spec.nodeName=$node_name -o=jsonpath='{range .items[*]}{.metadata.namespace}{" "}{.metadata.name}{"\n"}{end}')
        set namespace (echo $line | cut -d ' ' -f 1)
        set pod (echo $line | cut -d ' ' -f 2)
        set usage (kubectl top pod $pod -n $namespace --no-headers)
        set cpu (echo $usage | awk '{print $2}')
        set mem (echo $usage | awk '{print $3}')
        printf "%-60s %-30s %-30s\n" $pod $cpu $mem
    end
end

# --- ARGOCD helper functions --- #

function appset --description 'List Argo CD ApplicationSets as a table (name, generators, app count, age, conditions)'
    argocd appset list -o json | jq -r '
      def age:
        (now - (.metadata.creationTimestamp | fromdateiso8601)) as $s
        | if $s >= 86400 then "\(($s / 86400) | floor)d"
          elif $s >= 3600 then "\(($s / 3600) | floor)h"
          elif $s >= 60 then "\(($s / 60) | floor)m"
          else "\($s | floor)s"
          end;

      ["NAME","GENERATORS","APP_COUNT","AGE","CONDITIONS"],
      (.[] | [
        .metadata.name,
        ([.spec.generators[] | keys[]] | unique | join(",")),
        ((.status.resources // []) | length | tostring),
        age,
        ((.status.conditions // []) |
          map(
            select(
              (.type == "ErrorOccurred" and .status == "True")
              or
              (.type != "ErrorOccurred" and .status == "False")
            )
            | "\(.type):\(.reason // "")"
          ) |
          join(",")
        )
      ]) | @tsv
    ' | column -t
end
